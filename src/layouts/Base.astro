---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, cleanPath } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  markdownAlternate?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  lang?: string;
  headerTone?: 'paper' | 'brand';
  /** Absolute or root-relative URL of a 1200×630 share image. */
  image?: string;
}
const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  markdownAlternate,
  jsonLd = [],
  noindex = false,
  lang = 'en',
  headerTone = 'paper',
  image = '/og.png',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(cleanPath(Astro.url.pathname), SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const person = { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.author, url: `${SITE.url}/about`, sameAs: [SITE.github] };
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  inLanguage: 'en',
  author: person,
  publisher: person,
};
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#F5EEE2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#120A0C" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM-friendly site summary" href="/llms.txt" />
    {markdownAlternate && <link rel="alternate" type="text/markdown" title="Markdown source" href={markdownAlternate} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={SITE.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,0..100;1,9..144,300..600,0..100&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=Instrument+Sans:wght@400..600&family=Noto+Serif+Malayalam:wght@400..600&family=Noto+Serif+Devanagari:wght@400..600&family=Noto+Serif+Tamil:wght@400..600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...d })} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
