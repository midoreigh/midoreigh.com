---
import { SITE, CATEGORIES } from '../lib/site';
const year = new Date().getFullYear();
const links = [
  { href: '/blog', label: 'Journal' },
  ...Object.entries(CATEGORIES).map(([k, c]) => ({ href: `/blog/category/${k}`, label: c.name })),
  { href: '/about', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<footer class="site-footer">
  <div class="wrap">
    <!-- A colophon plate: one centred composition inside a double gold rule -->
    <div class="plate" data-reveal>
      <i class="lz tl"></i><i class="lz tr"></i><i class="lz bl"></i><i class="lz br"></i>
      <svg class="crest" viewBox="-12 -12 24 24" aria-hidden="true"><rect x="-8" y="-8" width="16" height="16" transform="rotate(45)" /><circle r="4.5" /><circle r="1.4" class="b" /></svg>
      <p class="mast display">mido<em>reigh</em></p>
      <p class="tagline">A journal of geopolitics, technology &amp; culture</p>
      <span class="rule" aria-hidden="true"><i></i></span>
      <nav aria-label="Footer">
        <ul class="links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <p class="welcome"><span lang="ml">സ്വാഗതം</span> · <span lang="hi">स्वागत</span> · <span lang="ta">வரவேற்பு</span></p>
    </div>
    <div class="base">
      <span>© {year} {SITE.author}</span>
      <span>Set in Fraunces &amp; Newsreader</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 8rem; padding: 5rem 0 2.2rem; color: var(--cream);
    background:
      var(--tex-grain) 0 0 / 180px 180px,
      var(--tex-brocade) 0 0 / 44px 44px,
      radial-gradient(90% 70% at 50% 0%, rgba(140, 26, 46, .5), transparent 70%),
      var(--maroon-deep);
    border-top: 1px solid var(--gilt-soft);
  }

  .plate {
    position: relative; max-width: 880px; margin: 0 auto; text-align: center;
    padding: clamp(2.6rem, 6vw, 4.2rem) clamp(1.2rem, 5vw, 4rem) clamp(2.2rem, 5vw, 3.4rem);
    border: 1px solid rgba(201, 162, 75, .8);
  }
  .plate::after { content: ''; position: absolute; inset: 6px; border: 1px solid rgba(201, 162, 75, .32); pointer-events: none; }
  .lz { position: absolute; width: 7px; height: 7px; background: var(--gilt); transform: rotate(45deg); }
  .tl { left: -4px; top: -4px; } .tr { right: -4px; top: -4px; } .bl { left: -4px; bottom: -4px; } .br { right: -4px; bottom: -4px; }

  .crest { width: 34px; height: 34px; display: block; margin: 0 auto 1.4rem; }
  .crest :is(rect, circle) { fill: none; stroke: var(--gilt); stroke-width: 1.1; }
  .crest .b { fill: var(--gilt); stroke: none; }

  /* Line-height leaves room for the italic g's descender above the tagline */
  .mast { font-size: clamp(3.2rem, 8vw, 5.6rem); line-height: 1.05; margin: 0; color: var(--cream); letter-spacing: -.035em; }
  .mast em { color: var(--gilt); }
  .tagline { margin: .9rem 0 0; font-style: italic; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: rgba(243, 231, 211, .78); }

  .rule { color: var(--gilt); max-width: 360px; margin: 2rem auto; }

  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .6rem 0; }
  .links li { display: flex; align-items: center; }
  /* Gold lozenge between links */
  .links li + li::before { content: ''; width: 5px; height: 5px; margin: 0 1.1rem; background: var(--gilt); opacity: .7; transform: rotate(45deg); }
  .links a {
    font-family: var(--font-ui); font-size: .74rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase;
    color: var(--cream); text-decoration: none; padding: .3rem 0;
    background: linear-gradient(var(--gilt), var(--gilt)) 50% 100% / 0 1px no-repeat; transition: background-size .5s var(--ease), color .3s;
  }
  .links a:hover { color: var(--gilt); background-size: 100% 1px; }

  .welcome { margin: 2rem 0 0; color: var(--gilt); font-size: .95rem; }

  .base {
    display: flex; justify-content: space-between; gap: .6rem 1.5rem; flex-wrap: wrap; max-width: 880px; margin: 1.8rem auto 0;
    font-family: var(--font-ui); font-size: .76rem; letter-spacing: .06em; color: rgba(243, 231, 211, .55);
  }
  /* Narrow screens: a two-column list, since a wrapped row would start lines with a lozenge */
  @media (max-width: 640px) {
    .links { display: grid; grid-template-columns: repeat(2, minmax(0, max-content)); justify-content: center; gap: .9rem 2.6rem; }
    .links li { justify-content: center; }
    .links li + li::before { display: none; }
    .base { justify-content: center; text-align: center; }
  }
</style>
