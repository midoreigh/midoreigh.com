---
// Line-art emblem per category, drawn in the same hairline as the yantra.
import { lotus, ring } from '../lib/motifs';
interface Props { kind: 'geopolitics' | 'tech' | 'culture' | 'notes'; class?: string }
const { kind, class: cls = '' } = Astro.props;
const ticks = ring(1, 72);
---
<svg class:list={['emblem', cls]} viewBox="-110 -110 220 220" aria-hidden="true">
  {kind === 'geopolitics' && (
    <g>
      <circle r="104" />
      {ticks.map(({ angle }, i) => (
        <line y1="-104" y2={i % 6 === 0 ? -94 : -99} transform={`rotate(${angle})`} />
      ))}
      <g class="spin">
        <circle r="78" />
        <ellipse rx="26" ry="78" /><ellipse rx="52" ry="78" />
        <line x1="-78" x2="78" />
        <line x1="-67" x2="67" y1="-40" y2="-40" /><line x1="-67" x2="67" y1="40" y2="40" />
      </g>
      <path class="fill" d="M0,-60 L6,-6 L60,0 L6,6 L0,60 L-6,6 L-60,0 L-6,-6Z" />
    </g>
  )}
  {kind === 'tech' && (
    <g>
      <rect x="-90" y="-90" width="180" height="180" />
      <rect x="-80" y="-80" width="160" height="160" />
      <g class="spin">
        <rect x="-56" y="-56" width="112" height="112" />
        <rect x="-56" y="-56" width="112" height="112" transform="rotate(45)" />
        <circle r="34" />
      </g>
      {[[-80, -80], [80, -80], [80, 80], [-80, 80]].map(([x, y]) => (
        <><line x1={x} y1={y} x2={x * 0.7} y2={y * 0.7} /><circle class="fill" cx={x * 0.7} cy={y * 0.7} r="3" /></>
      ))}
      {[[0, -80], [80, 0], [0, 80], [-80, 0]].map(([x, y]) => <circle class="fill" cx={x} cy={y} r="3" />)}
      <circle class="fill" r="5" />
    </g>
  )}
  {kind === 'culture' && (
    <g>
      <path d="M-100,10 A100,100 0 0 1 100,10" />
      <path d="M-82,10 A82,82 0 0 1 82,10" class="spin-slow" />
      {[-60, -30, 0, 30, 60].map((a) => <path d={lotus(0, a === 0 ? 92 : 74, 36)} transform={`translate(0 40) rotate(${a})`} />)}
      <path d="M-96,52 Q-72,44 -48,52 T0,52 T48,52 T96,52" />
      <path d="M-80,66 Q-60,58 -40,66 T0,66 T40,66 T80,66" />
      <path d="M-60,80 Q-45,72 -30,80 T0,80 T30,80 T60,80" />
      <circle class="fill" cy="-62" r="4" />
    </g>
  )}
  {kind === 'notes' && (
    <g>
      <rect x="-100" y="-24" width="200" height="48" rx="24" />
      <rect x="-92" y="-17" width="184" height="34" rx="17" />
      <circle cx="-50" r="5" /><circle cx="50" r="5" />
      {[-6, 0, 6].map((y) => <line x1="-36" x2="36" y1={y} y2={y} />)}
      <line x1="-80" x2="-64" y1="0" y2="0" /><line x1="64" x2="80" y1="0" y2="0" />
    </g>
  )}
</svg>

<style>
  .emblem { display: block; overflow: visible; color: inherit; }
  .emblem :is(path, circle, ellipse, rect, line) { fill: none; stroke: currentColor; stroke-width: 1.1; vector-effect: non-scaling-stroke; }
  .emblem .fill { fill: currentColor; stroke: none; }
  .spin { transform-box: fill-box; transform-origin: center; transition: rotate 1.6s var(--ease); }
</style>
