---
// A pierced-stone screen (jaali) laid over whatever is slotted in. Its star-shaped
// holes grow until the content underneath is fully revealed.
//   mode="scrub"  holes follow scroll position (eased, so wheel steps glide)
//   mode="enter"  holes open once when the element comes into view
//   mode="hover"  holes open on hover; on touch screens they open once the
//                 element's top passes the middle of the screen
interface Props {
  mode?: 'scrub' | 'enter' | 'hover';
  /** Lattice cell size in px. */
  tile?: number;
  /** Hole scale while closed: ~0.3 is almost shut, ~1 shows the lattice clearly. */
  closed?: number;
  /** Stone colour; defaults to the page background so the screen reads as cut from the page. */
  stone?: string;
  class?: string;
  style?: string;
}
const { mode = 'enter', tile = 44, closed = 0.35, stone = 'var(--bg)', class: cls = '', style } = Astro.props;

const id = `jaali-${Math.random().toString(36).slice(2, 9)}`;

// Eight-point star centred in the cell, at scale s. Shared logic with the client script below.
function starPath(t: number, s: number): string {
  const c = t / 2;
  const pts: string[] = [];
  for (let i = 0; i < 16; i++) {
    const a = ((i * 22.5 - 90) * Math.PI) / 180;
    const r = (i % 2 ? c * 0.62 : c) * s;
    pts.push(`${(c + r * Math.cos(a)).toFixed(2)},${(c + r * Math.sin(a)).toFixed(2)}`);
  }
  return `M${pts.join(' L')}Z`;
}
const cell = `M0,0 H${tile} V${tile} H0 Z `;
---
<div class:list={['jaali', cls]} data-jaali={mode} data-closed={closed} data-tile={tile} style={style}>
  <slot />
  <svg class="screen" aria-hidden="true" style={`--stone:${stone}`}>
    <defs>
      <!-- One cell: the stone square with a star punched out (even-odd), plus the star's gold rim -->
      <pattern id={id} width={tile} height={tile} patternUnits="userSpaceOnUse">
        <path data-stone class="stone" fill-rule="evenodd" d={cell + starPath(tile, closed)} />
        <path data-rim class="rim" d={starPath(tile, closed)} />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`} />
  </svg>
</div>

<script>
  // Hole scale at which a star covers its whole cell and the screen disappears.
  const OPEN = 2.5;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Some Android browsers report (hover: hover) on touchscreens; require a fine pointer too.
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const smooth = (t: number) => t * t * (3 - 2 * t);

  function starPath(t: number, s: number): string {
    const c = t / 2;
    let d = 'M';
    for (let i = 0; i < 16; i++) {
      const a = ((i * 22.5 - 90) * Math.PI) / 180;
      const r = (i % 2 ? c * 0.62 : c) * s;
      d += `${i ? ' L' : ''}${(c + r * Math.cos(a)).toFixed(2)},${(c + r * Math.sin(a)).toFixed(2)}`;
    }
    return d + 'Z';
  }

  type J = {
    el: HTMLElement; stone: SVGPathElement; rim: SVGPathElement; tile: number; closed: number;
    p: number; ease: (t: number) => number; raf?: number;
  };
  const all: J[] = [...document.querySelectorAll<HTMLElement>('[data-jaali]')].map((el) => ({
    el,
    stone: el.querySelector<SVGPathElement>('[data-stone]')!,
    rim: el.querySelector<SVGPathElement>('[data-rim]')!,
    tile: Number(el.dataset.tile),
    closed: Number(el.dataset.closed),
    p: 0,
    ease: easeOut,
  }));

  // p: 0 = closed, 1 = fully open (screen hidden)
  function set(j: J, p: number) {
    j.p = p;
    if (p >= 1) { j.el.classList.add('is-open'); return; }
    j.el.classList.remove('is-open');
    const star = starPath(j.tile, j.closed + (OPEN - j.closed) * j.ease(p));
    j.stone.setAttribute('d', `M0,0 H${j.tile} V${j.tile} H0 Z ${star}`);
    j.rim.setAttribute('d', star);
  }
  function tween(j: J, to: number, ms: number) {
    if (j.raf) cancelAnimationFrame(j.raf);
    const from = j.p, t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / ms);
      set(j, from + (to - from) * k);
      if (k < 1) j.raf = requestAnimationFrame(step);
    };
    j.raf = requestAnimationFrame(step);
  }
  function openWhenSeen(j: J, opts: IntersectionObserverInit) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { tween(j, 1, 1600); io.disconnect(); }
    }, opts);
    io.observe(j.el);
  }

  const scrubbers: { j: J; target: number }[] = [];
  for (const j of all) {
    const mode = j.el.dataset.jaali;
    if (reduce) { set(j, mode === 'hover' && canHover ? 0 : 1); continue; }
    if (mode === 'enter') {
      openWhenSeen(j, { threshold: 0.25 });
    } else if (mode === 'hover' && canHover) {
      const host = j.el.closest('[data-jaali-host]') ?? j.el;
      host.addEventListener('pointerenter', () => tween(j, 1, 900));
      host.addEventListener('pointerleave', () => tween(j, 0, 700));
    } else if (mode === 'hover') {
      // Touch: open once the element's top passes the middle of the screen. The zone runs to the
      // top edge, so a fast flick can't skip over it.
      openWhenSeen(j, { rootMargin: '0px 0px -50% 0px' });
    } else {
      j.ease = smooth;
      scrubbers.push({ j, target: 0 });
    }
  }

  if (scrubbers.length) {
    // Scroll sets a target; a frame loop glides the holes toward it, so coarse
    // wheel steps and flicks still read as continuous motion.
    let running = false;
    const measure = () => {
      const vh = innerHeight;
      for (const s of scrubbers) {
        const r = s.j.el.getBoundingClientRect();
        // Starts opening as the top enters the viewport; fully open once the top is near the top of the screen.
        s.target = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.85)));
      }
      if (!running) { running = true; requestAnimationFrame(frame); }
    };
    const frame = () => {
      let moving = false;
      for (const { j, target } of scrubbers) {
        const d = target - j.p;
        if (Math.abs(d) > 0.001) { set(j, j.p + d * 0.14); moving = true; }
        else if (j.p !== target) set(j, target);
      }
      if (moving) requestAnimationFrame(frame);
      else running = false;
    };
    addEventListener('scroll', measure, { passive: true });
    addEventListener('resize', measure);
    measure();
  }
</script>

<style>
  .jaali { position: relative; overflow: hidden; isolation: isolate; }
  .screen { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }
  .stone { fill: var(--stone); }
  .rim { fill: none; stroke: var(--gold); stroke-opacity: .55; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .is-open .screen, :global(.no-js) .screen { display: none; }
</style>
