---
// Fine gold line-work yantra: square gateway frame (bhupura), lotus rings,
// interlocking triangles and a bindu. Paths draw themselves in on load.
import { petal, lotus, ring } from '../lib/motifs';

interface Props { class?: string; draw?: boolean }
const { class: cls = '', draw = true } = Astro.props;

// Square frame with a T-shaped gate on each side.
function bhupura(s: number, g: number, d: number, w: number, h: number): string {
  const side = [[-s, -s], [-g, -s], [-g, -s - d], [-g - w, -s - d], [-g - w, -s - d - h], [g + w, -s - d - h], [g + w, -s - d], [g, -s - d], [g, -s]];
  const pts: number[][] = [];
  for (let k = 0; k < 4; k++) {
    const a = (k * Math.PI) / 2, c = Math.cos(a), sn = Math.sin(a);
    for (const [x, y] of side) pts.push([+(x * c - y * sn).toFixed(2), +(x * sn + y * c).toFixed(2)]);
  }
  return `M${pts.map((p) => p.join(',')).join(' L')}Z`;
}
const tri = (r: number, up: boolean, dy = 0) => {
  const s = up ? -1 : 1;
  return `M0,${s * r + dy} L${(r * 0.866).toFixed(1)},${-s * r * 0.5 + dy} L${(-r * 0.866).toFixed(1)},${-s * r * 0.5 + dy}Z`;
};
const p16 = Array.from({ length: 16 }, (_, i) => i * 22.5);
const p8 = Array.from({ length: 8 }, (_, i) => i * 45);
---
<svg class:list={['yantra', cls, { draw }]} viewBox="-300 -300 600 600" aria-hidden="true">
  <g class="y-frame">
    <path d={bhupura(270, 46, 0, 20, 22)} pathLength="1" style="--o:0" />
    <path d={bhupura(258, 40, 0, 18, 20)} pathLength="1" style="--o:1" />
    <path d={bhupura(246, 34, 0, 16, 18)} pathLength="1" style="--o:2" />
  </g>
  <g class="y-outer">
    <circle r="222" pathLength="1" style="--o:3" />
    <circle r="214" pathLength="1" style="--o:3" />
    {ring(218, 96).map((p) => <circle class="dot" cx={p.x} cy={p.y} r="1.1" />)}
    {p16.map((a, i) => <path d={lotus(156, 210, 50)} transform={`rotate(${a})`} pathLength="1" style={`--o:${4 + i * 0.08}`} />)}
    {p16.map((a, i) => <path d={petal(168, 198, 16)} transform={`rotate(${a})`} pathLength="1" style={`--o:${5 + i * 0.08}`} />)}
  </g>
  <g class="y-inner">
    <circle r="150" pathLength="1" style="--o:5" />
    {p8.map((a, i) => <path d={lotus(106, 148, 64)} transform={`rotate(${a + 22.5})`} pathLength="1" style={`--o:${6 + i * 0.1}`} />)}
    <circle r="102" pathLength="1" style="--o:6" />
  </g>
  <g class="y-core">
    <path d={tri(96, true, 6)} pathLength="1" style="--o:7" />
    <path d={tri(96, false, -6)} pathLength="1" style="--o:7.2" />
    <path d={tri(66, true, -10)} pathLength="1" style="--o:7.4" />
    <path d={tri(66, false, 10)} pathLength="1" style="--o:7.6" />
    <path d={tri(38, true, 4)} pathLength="1" style="--o:7.8" />
    <circle r="14" pathLength="1" style="--o:8" />
    <circle class="bindu" r="4" />
  </g>
</svg>

<style>
  .yantra { display: block; overflow: visible; color: var(--gilt); }
  .yantra path, .yantra circle { fill: none; stroke: currentColor; stroke-width: var(--yw, .7); }
  .yantra .dot, .yantra .bindu { fill: currentColor; stroke: none; }
  .y-frame, .y-outer, .y-inner, .y-core { transform-box: fill-box; transform-origin: center; }
  .y-outer { animation: y-spin 240s linear infinite; }
  .y-inner { animation: y-spin 180s linear infinite reverse; }

  .draw path, .draw circle:not(.dot):not(.bindu) {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: y-draw 2.2s var(--ease) forwards; animation-delay: calc(.25s + var(--o, 0) * .14s);
  }
  .draw .dot, .draw .bindu { opacity: 0; animation: y-fade 1s 1.4s forwards; }
  @keyframes y-draw { to { stroke-dashoffset: 0; } }
  @keyframes y-fade { to { opacity: 1; } }
  @keyframes y-spin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) {
    .draw path, .draw circle { stroke-dashoffset: 0 !important; opacity: 1 !important; }
  }
</style>
