---
import { cleanPath } from '../lib/site';

interface Props { tone?: 'paper' | 'brand' }
const { tone = 'paper' } = Astro.props;
const path = cleanPath(Astro.url.pathname);
const links = [
  { href: '/blog', label: 'Journal' },
  { href: '/blog/category/geopolitics', label: 'Geopolitics' },
  { href: '/blog/category/tech', label: 'Tech' },
  { href: '/blog/category/culture', label: 'Culture' },
  { href: '/about', label: 'About' },
];
---
<header class:list={['site-header', `tone-${tone}`]}>
  <nav class="wrap nav" aria-label="Primary">
    <a class="brand" href="/" aria-label="Midoreigh, home">
      <svg viewBox="-12 -12 24 24" aria-hidden="true"><rect x="-8" y="-8" width="16" height="16" transform="rotate(45)" /><circle r="4.5" /><circle r="1.4" class="b" /></svg>
      <span>mido<i>reigh</i></span>
    </a>
    <div class="theme" role="group" aria-label="Colour theme">
      <button type="button" data-choice="light" aria-label="Light theme" title="Light">
        <svg viewBox="-12 -12 24 24" aria-hidden="true"><circle r="4.5" /><path d="M0,-10v3M0,7v3M-10,0h3M7,0h3M-7.1,-7.1l2.1,2.1M5,5l2.1,2.1M-7.1,7.1l2.1,-2.1M5,-5l2.1,-2.1" /></svg>
      </button>
      <button type="button" data-choice="system" aria-label="Match system theme" title="System">
        <svg viewBox="-12 -12 24 24" aria-hidden="true"><circle r="8" /><path class="f" d="M0,-8A8,8 0 0 1 0,8Z" /></svg>
      </button>
      <button type="button" data-choice="dark" aria-label="Dark theme" title="Dark">
        <svg viewBox="-12 -12 24 24" aria-hidden="true"><path d="M3.5,-8.2A8.5,8.5 0 1 0 8.2,3.5A6.5,6.5 0 0 1 3.5,-8.2Z" /></svg>
      </button>
    </div>
    <!-- The <details> only drives the mobile menu; links live outside it so they show on desktop -->
    <details class="menu">
      <summary aria-label="Menu"><span></span><span></span></summary>
    </details>
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme button');
  const current = () => root.dataset.theme ?? 'system';
  const mark = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.choice === current())));
  buttons.forEach((b) => b.addEventListener('click', () => window.__setTheme(b.dataset.choice!)));
  root.addEventListener('themechange', mark);
  window.__setTheme(current());
</script>

<style>
  /* Transparent so the dark-mode lacquer layer runs up behind it */
  .site-header { position: relative; z-index: 40; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); }
  .site-header.tone-brand { background: var(--maroon-deep); color: var(--cream); border-color: var(--gilt-soft); }
  .nav { display: flex; align-items: center; gap: 1.6rem; height: 72px; }
  .brand { display: flex; align-items: center; gap: .7rem; text-decoration: none; font-family: var(--font-display); font-size: 1.55rem; font-weight: 400; letter-spacing: -.01em; font-variation-settings: 'opsz' 48; }
  .brand i { font-weight: 300; }
  .brand svg { width: 26px; height: 26px; transition: rotate 1s var(--ease); }
  .brand svg :is(rect, circle) { fill: none; stroke: var(--gold); stroke-width: 1.2; }
  .tone-brand .brand svg :is(rect, circle) { stroke: var(--gilt); }
  .tone-brand .brand svg .b { fill: var(--gilt); }
  .brand svg .b { fill: var(--gold); stroke: none; }
  .brand:hover svg { rotate: 90deg; }
  .menu { display: none; }
  .links { display: flex; gap: 2.2rem; list-style: none; margin: 0 0 0 auto; padding: 0; }
  .links a {
    font-family: var(--font-ui); font-size: .76rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase;
    text-decoration: none; padding: .4rem 0;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .45s var(--ease);
  }
  .links a:hover, .links a[aria-current='page'] { background-size: 100% 1px; }
  @media (min-width: 821px) { .theme { order: 1; } }

  .theme { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line-strong); border-radius: 999px; }
  .tone-brand .theme { border-color: var(--gilt-soft); }
  .theme button {
    display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 999px;
    background: none; color: inherit; cursor: pointer; opacity: .55; transition: opacity .3s, background .3s;
  }
  .theme button:hover { opacity: 1; }
  .theme button[aria-pressed='true'] { opacity: 1; background: var(--line); }
  .tone-brand .theme button[aria-pressed='true'] { background: rgba(243, 231, 211, .14); }
  .theme svg { width: 16px; height: 16px; }
  .theme svg :is(circle, path) { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; }
  .theme svg .f { fill: currentColor; stroke: none; }
  @media (max-width: 820px) {
    .theme { margin-left: auto; }
    .menu { display: block; }
    .menu summary { display: grid; gap: 7px; cursor: pointer; padding: 12px 4px; list-style: none; }
    .menu summary::-webkit-details-marker { display: none; }
    .menu summary span { width: 26px; height: 1px; background: currentColor; display: block; }
    .links {
      display: none; position: absolute; left: 0; right: 0; top: 72px; flex-direction: column; gap: 0; margin: 0;
      padding: 1rem 16px 1.5rem; border-bottom: 1px solid var(--line);
    }
    .menu[open] ~ .links { display: flex; }
    .site-header.tone-brand .links { background: var(--maroon-deep); }
    .site-header.tone-paper .links { background: var(--bg); }
    .links a { display: block; padding: .9rem 0; border-bottom: 1px solid var(--line); background: none; }
  }
</style>
