---
// Gilt miniature frame: a double gold rule with small corner lozenges around the
// slotted picture, like the border of a Mughal miniature. When it first comes into
// view the picture settles in and a soft gold sheen passes over it once.
// Size it from outside (width / aspect-ratio on `class`); --gilt-pad sets the margin and
// --gilt-hover the duration of any `scale` hover effect a parent applies to the picture.
interface Props { class?: string; style?: string }
const { class: cls = '', style } = Astro.props;
---
<div class:list={['gilt', cls]} style={style} data-gilt>
  <i class="lz tl"></i><i class="lz tr"></i><i class="lz bl"></i><i class="lz br"></i>
  <div class="pic"><slot /></div>
</div>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-gilt]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }, { threshold: 0.3 });
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .gilt { --gilt-pad: 12px; position: relative; padding: var(--gilt-pad); }
  /* Outer rule and a fainter inner rule */
  .gilt::before, .gilt::after { content: ''; position: absolute; pointer-events: none; border: 1px solid var(--gold); }
  .gilt::before { inset: 0; opacity: .85; }
  .gilt::after { inset: calc(var(--gilt-pad) / 2 - 1px); opacity: .4; }
  .lz { position: absolute; z-index: 1; width: 6px; height: 6px; background: var(--gold); transform: rotate(45deg); }
  .tl { left: -3px; top: -3px; } .tr { right: -3px; top: -3px; } .bl { left: -3px; bottom: -3px; } .br { right: -3px; bottom: -3px; }

  .pic { position: relative; height: 100%; overflow: hidden; isolation: isolate; }
  .pic > :global(*) {
    opacity: 0; transform: scale(1.06);
    transition: opacity 1.2s var(--ease), transform 1.6s var(--ease), scale var(--gilt-hover, .9s) var(--ease);
  }
  .is-in .pic > :global(*), :global(.no-js) .pic > :global(*) { opacity: 1; transform: none; }
  /* One pass of gold light across the picture */
  .pic::after {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 233, 176, .38) 50%, transparent 65%);
    transform: translateX(-120%);
  }
  .is-in .pic::after { transform: translateX(120%); transition: transform 1.8s var(--ease) .35s; }
</style>
