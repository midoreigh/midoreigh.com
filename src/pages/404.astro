---
import Base from '../layouts/Base.astro';
import Yantra from '../components/Yantra.astro';
---
<Base title="Page not found" description="This page wandered off." noindex>
  <section class="wrap nf">
    <Yantra class="nf-y" />
    <h1 class="display">Lost in the <em>bazaar</em></h1>
    <p class="dek">This lane doesn’t exist. <a href="/">Return to the front page →</a></p>
  </section>
</Base>
<style>
  .nf { text-align: center; padding: 5rem 0 0; }
  .nf :global(.nf-y) { width: min(320px, 70vw); margin: 0 auto; color: var(--gold); }
  h1 { font-size: clamp(3rem, 9vw, 6rem); margin: 2rem 0 1rem; }
  h1 em { color: var(--gold); }
  .dek { font-size: 1.3rem; }
</style>
