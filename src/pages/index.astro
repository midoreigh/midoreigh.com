---
import Base from '../layouts/Base.astro';
import Yantra from '../components/Yantra.astro';
import Emblem from '../components/Emblem.astro';
import PostRow from '../components/PostRow.astro';
import { Image } from 'astro:assets';
import Gilt from '../components/Gilt.astro';
import { SITE, CATEGORIES, getPosts, readingTime, formatDate } from '../lib/site';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p !== featured).slice(0, 6);
// The cover frame is 4:5, so a wider image renders wider than the frame and is cropped; ask for enough pixels.
const coverCrop = featured?.data.cover ? Math.max(1, featured.data.cover.width / featured.data.cover.height / (4 / 5)) : 1;
const coverSizes = `(max-width: 820px) ${Math.ceil(100 * coverCrop)}vw, ${Math.ceil(40 * coverCrop)}vw`;
const sections = (['geopolitics', 'tech', 'culture'] as const).map((k) => ({
  key: k,
  ...CATEGORIES[k],
  count: posts.filter((p) => p.data.category === k).length,
}));
const issueDate = new Date().toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/#blog`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    author: { '@id': `${SITE.url}/#person` },
    blogPost: posts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${SITE.url}/blog/${p.id}`,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
];
---
<Base jsonLd={jsonLd} headerTone="brand">
  <section class="hero" aria-labelledby="hero-title">
    <svg class="jaali" aria-hidden="true">
      <defs>
        <pattern id="jaali" width="56" height="56" patternUnits="userSpaceOnUse">
          <path d="M28,0 L56,28 L28,56 L0,28 Z M28,14 L42,28 L28,42 L14,28 Z" fill="none" stroke="currentColor" stroke-width=".6" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#jaali)" />
    </svg>
    <div class="yantra-wrap" aria-hidden="true"><Yantra class="hero-yantra" /></div>

    <div class="wrap hero-inner">
      <div class="meta-row">
        <span>Vol. I</span>
        <span class="mid">Geopolitics · Technology · Culture</span>
        <span>{issueDate}</span>
      </div>
      <span class="hairline" aria-hidden="true"></span>

      <h1 id="hero-title" class="display wordmark">
        <span class="sr-only">midoreigh</span>
        <span class="line" aria-hidden="true">
          {'mido'.split('').map((c, i) => <span class="ch" style={`--i:${i}`}>{c}</span>)}<em>{'reigh'.split('').map((c, i) => <span class="ch" style={`--i:${i + 4}`}>{c}</span>)}</em>
        </span>
      </h1>

      <div class="hero-foot">
        <p class="hero-dek">
          A personal journal of long-form essays and notes — on the long game of nations, the machines
          rewiring our lives, and the cultures we live inside.
        </p>
        <div class="hero-links">
          <a class="link on-dark" href="/blog">Read the journal <span aria-hidden="true">→</span></a>
          <a class="link on-dark" href="/about">About the author <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span></span></div>
  </section>

  {featured && (
    <section class="wrap cover" aria-labelledby="cover-title">
      <a class="cover-art" href={`/blog/${featured.id}`} tabindex="-1" aria-hidden="true" style={`--c:${CATEGORIES[featured.data.category].color}`} data-gilt-host>
        <Gilt class="cover-gilt" float tilt={6}>
          {featured.data.cover ? (
            <Image class="fill-img" src={featured.data.cover} alt="" widths={[480, 800, 1200, 1600, 2400]} sizes={coverSizes} loading="eager" />
          ) : (
            <div class="panel"><Emblem kind={featured.data.category} class="cover-emblem" /></div>
          )}
        </Gilt>
      </a>
      <div class="cover-copy">
        <p class="kicker" data-reveal>Cover story · {CATEGORIES[featured.data.category].name}</p>
        <h2 id="cover-title" class="display cover-title" data-reveal style="--d:1" lang={featured.data.lang}>
          <a href={`/blog/${featured.id}`}>{featured.data.title}</a>
        </h2>
        <p class="dek cover-dek" data-reveal style="--d:2" lang={featured.data.lang}>{featured.data.description}</p>
        <p class="byline" data-reveal style="--d:3">
          {SITE.author} · {formatDate(featured.data.pubDate)} · {readingTime(featured.body)} min read
        </p>
        <a class="link" href={`/blog/${featured.id}`} data-reveal style="--d:4">Read the essay <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="wrap contents" aria-labelledby="contents-title">
      <div class="section-head">
        <div>
          <p class="kicker" data-reveal>In this issue</p>
          <h2 id="contents-title" class="display h-section" data-reveal style="--d:1">Latest <em>dispatches</em></h2>
        </div>
        <a class="link" href="/blog" data-reveal style="--d:2">All essays →</a>
      </div>
      <ol class="rows">
        {latest.map((post, i) => <PostRow post={post} n={i} />)}
      </ol>
    </section>
  )}

  <section class="sections" aria-labelledby="sections-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker" data-reveal>Three rivers, one confluence</p>
          <h2 id="sections-title" class="display h-section" data-reveal style="--d:1">What I <em>write about</em></h2>
        </div>
      </div>
      <div class="sec-grid">
        {sections.map((s, i) => (
          <a class="sec" href={`/blog/category/${s.key}`} style={`--c:${s.color}; --d:${i}`} data-reveal data-sec data-gilt-host>
            <Gilt class="sec-gilt" float tilt={9} style={`--i:${i}`}>
              <div class="panel">
                <span class="sec-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <Emblem kind={s.key} class="sec-emblem" />
              </div>
            </Gilt>
            <p class="sec-num">0{i + 1}</p>
            <h3 class="display">{s.name}</h3>
            <p class="sec-blurb">{s.blurb}</p>
            <span class="sec-count">{s.count} {s.count === 1 ? 'essay' : 'essays'} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap motto" aria-label="Motto" data-gilt-host>
    <Gilt class="motto-card" float tilt={3}>
      <div class="motto-panel">
        <p class="display motto-text">“Let noble thoughts come to us <em>from every direction.</em>”</p>
        <p class="kicker motto-cite">Rig Veda · 1.89.1</p>
      </div>
    </Gilt>
  </section>
</Base>

<script>
  // Scroll-linked hero: the yantra turns, grows and recedes as you scroll;
  // [data-parallax] elements drift relative to the viewport centre.
  const hero = document.querySelector<HTMLElement>('.hero');
  const drifters = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let ticking = false;
  function update() {
    ticking = false;
    if (hero) {
      const p = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
      hero.style.setProperty('--p', p.toFixed(4));
    }
    const vh = window.innerHeight;
    for (const el of drifters) {
      const r = el.getBoundingClientRect();
      if (r.bottom < -200 || r.top > vh + 200) continue;
      const offset = r.top + r.height / 2 - vh / 2;
      el.style.translate = `0 ${(offset * Number(el.dataset.parallax)).toFixed(1)}px`;
    }
  }
  // Touch screens can't hover: draw each section card's frame once it passes the middle of the screen.
  if (!matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-drawn'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -50% 0px' });
    document.querySelectorAll('[data-sec]').forEach((el) => io.observe(el));
  }
  if (!reduce) {
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  /* ---------- HERO ---------- */
  .hero {
    --p: 0;
    position: relative; isolation: isolate; overflow: hidden;
    min-height: calc(100svh - 72px);
    display: flex; flex-direction: column;
    background: radial-gradient(90% 80% at 78% 45%, #5a1220 0%, var(--maroon-deep) 62%);
    color: var(--cream);
  }
  .jaali { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--gilt); opacity: .09; z-index: -2; }
  .yantra-wrap {
    position: absolute; z-index: -1; right: -14vmin; top: 50%;
    width: min(118vmin, 1100px); aspect-ratio: 1;
    translate: 0 calc(-50% + var(--p) * 18vh);
    rotate: calc(var(--p) * 60deg);
    scale: calc(1 + var(--p) * .25);
    opacity: calc(.62 - var(--p) * .4);
  }
  @media (max-width: 1100px) { .yantra-wrap { right: -30vmin; opacity: calc(.42 - var(--p) * .3); } }
  .yantra-wrap :global(.hero-yantra) { width: 100%; height: 100%; }

  .hero-inner { flex: 1; display: flex; flex-direction: column; padding: 2rem 0 4.5rem; }
  .meta-row {
    display: flex; justify-content: space-between; gap: 1rem;
    font-family: var(--font-ui); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--gilt);
    animation: fade 1.2s .2s both;
  }
  .hairline { display: block; height: 1px; background: var(--gilt-soft); margin-top: 1rem; transform-origin: left; animation: grow 1.6s var(--ease) .1s both; }

  .wordmark {
    margin: auto 0 0; padding-top: 3rem;
    font-size: clamp(4.6rem, 19vw, 17.5rem); line-height: .82; letter-spacing: -.045em;
    font-weight: 300; font-variation-settings: 'opsz' 144, 'SOFT' 0;
  }
  /* Clips the letters for the rise-in; tall enough below for the italic g's descender
     (the negative margin keeps the layout where it was) */
  .wordmark .line { display: block; overflow: hidden; padding: .04em .08em .36em 0; margin-bottom: -.24em; }
  .wordmark em { color: var(--gilt); font-weight: 300; }
  .ch { display: inline-block; animation: rise 1.4s var(--ease) both; animation-delay: calc(.35s + var(--i) * .065s); }

  .hero-foot {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem; align-items: end;
    margin-top: 2.2rem; padding-top: 1.6rem; border-top: 1px solid var(--gilt-soft);
    animation: fade 1.2s 1.2s both;
  }
  .hero-dek { margin: 0; max-width: 46ch; font-size: clamp(1.1rem, 1.6vw, 1.35rem); font-style: italic; color: rgba(243, 231, 211, .85); }
  .hero-links { display: flex; gap: 2.2rem; justify-content: flex-end; flex-wrap: wrap; }

  .scroll-cue { position: absolute; left: 50%; bottom: 0; width: 1px; height: 56px; background: var(--gilt-soft); overflow: hidden; }
  .scroll-cue span { position: absolute; inset: 0; background: var(--gilt); animation: cue 2.4s var(--ease) 2s infinite; transform: translateY(-100%); }

  /* Start far enough down that even ascenders (d, h, the dot of i) sit below the clip box */
  @keyframes rise { from { transform: translateY(1.6em); } to { transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes grow { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes cue { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }

  @media (max-width: 760px) {
    .meta-row .mid { display: none; }
    .yantra-wrap { right: -45vw; width: 130vw; opacity: calc(.45 - var(--p) * .3); }
    .hero-foot { grid-template-columns: 1fr; }
    .hero-links { justify-content: flex-start; }
  }

  /* ---------- COVER STORY ---------- */
  .cover { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding-top: 8rem; }
  .cover-art { display: block; }
  .cover-art :global(.cover-gilt) { aspect-ratio: 4 / 5; }
  .cover-art :global(.fill-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .panel { position: absolute; inset: 0; display: grid; place-items: center; background: var(--c); color: var(--gilt); }
  .panel :global(.cover-emblem) { width: 62%; }
  .cover-art:hover :global(.spin) { rotate: 45deg; }
  .cover-title { font-size: clamp(2.6rem, 5.6vw, 5rem); margin: .8rem 0 1.2rem; }
  .cover-title a { text-decoration: none; background: linear-gradient(var(--gold), var(--gold)) 0 95% / 0 1px no-repeat; transition: background-size .8s var(--ease); }
  .cover-title a:hover { background-size: 100% 1px; }
  .cover-dek { font-size: 1.35rem; margin: 0 0 1.6rem; max-width: 42ch; }
  .byline { font-family: var(--font-ui); font-size: .82rem; color: var(--ink-3); letter-spacing: .04em; margin: 0 0 2.2rem; }
  @media (max-width: 820px) { .cover { grid-template-columns: 1fr; padding-top: 5rem; } }

  /* ---------- CONTENTS ---------- */
  .contents { padding-top: 9rem; }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .rows { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }

  /* ---------- SECTIONS ---------- */
  .sections { padding-top: 9rem; }
  .sec-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.2rem, 3vw, 3rem); }
  .sec { text-decoration: none; display: flex; flex-direction: column; }
  .sec :global(.sec-gilt) { aspect-ratio: 1; --gilt-pad: 10px; }
  /* On arrival one beam of light travels across the row: each card's sheen starts as the
     previous one's passes, at a constant (linear) speed so it reads as a single sweep. */
  @media (min-width: 821px) {
    .sec :global(.sec-gilt) { --sweep-dur: 1.1s; --sweep-ease: linear; --sweep-delay: calc(.2s + var(--i) * .5s); }
  }
  /* Hover: the inner gold frame draws in from the corners while the emblem turns and grows.
     Everything shares one duration and easing, so it also unwinds together. */
  .sec { --dur: .9s; }
  .sec-frame { position: absolute; inset: 14px; pointer-events: none; }
  .sec-frame i { position: absolute; background: var(--gilt); transition: transform var(--dur) var(--ease); }
  .sec-frame i:nth-child(1) { top: 0; left: 0; right: 0; height: 1px; transform: scaleX(0); transform-origin: left; }
  .sec-frame i:nth-child(2) { top: 0; bottom: 0; right: 0; width: 1px; transform: scaleY(0); transform-origin: top; }
  .sec-frame i:nth-child(3) { bottom: 0; left: 0; right: 0; height: 1px; transform: scaleX(0); transform-origin: right; }
  .sec-frame i:nth-child(4) { top: 0; bottom: 0; left: 0; width: 1px; transform: scaleY(0); transform-origin: bottom; }
  /* Sized from the card's shorter side (container units) so it fits both the square (desktop)
     and wide (mobile) card */
  .sec .panel { container-type: size; }
  .sec :global(.sec-emblem) { width: 60cqmin; height: 60cqmin; }
  .sec :global(.spin) { transition-duration: var(--dur); }
  .sec.is-drawn .sec-frame i { transform: none; }
  .sec.is-drawn :global(.spin) { rotate: 45deg; }
  @media (hover: hover) and (pointer: fine) {
    .sec:hover .sec-frame i { transform: none; }
    .sec:hover :global(.spin) { rotate: 45deg; }
  }
  .sec-num { font-family: var(--font-ui); font-size: .75rem; letter-spacing: .2em; color: var(--gold); margin: 1.6rem 0 .3rem; }
  .sec h3 { font-size: clamp(2rem, 3.4vw, 3rem); margin: 0; }
  .sec-blurb { color: var(--ink-2); margin: .6rem 0 1.2rem; }
  .sec-count { margin-top: auto; font-family: var(--font-ui); font-size: .76rem; letter-spacing: .16em; text-transform: uppercase; }
  @media (max-width: 820px) { .sec-grid { grid-template-columns: 1fr; } .sec :global(.sec-gilt) { aspect-ratio: 16 / 9; } }

  /* ---------- MOTTO ---------- */
  .motto { margin-top: 9rem; }
  .motto :global(.motto-card) { max-width: 920px; margin: 0 auto; }
  .motto-panel {
    position: relative; text-align: center; background: var(--emerald-deep); color: var(--cream);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.4rem, 6vw, 5rem);
  }
  .motto-panel::before { content: ''; position: absolute; inset: 12px; border: 1px solid var(--gilt-soft); pointer-events: none; }
  .motto-text { font-size: clamp(1.9rem, 4.2vw, 3.4rem); margin: 0 0 1.4rem; line-height: 1.12; }
  .motto-text em { color: var(--gilt); }
  .motto-cite { color: var(--gilt); margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .yantra-wrap { translate: 0 -50%; rotate: none; scale: none; }
  }
</style>
